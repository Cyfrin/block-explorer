name: battlechain-indexer
description: Indexes BattleChain contract states and Safe Harbor agreements
repository: https://github.com/Cyfrin/block-explorer
project_type: no-code

networks:
  - name: battlechain
    chain_id: ${CHAIN_ID}
    rpc: ${BLOCKCHAIN_RPC_URL}

storage:
  postgres:
    enabled: true

contracts:
  # Core State Tracking - AttackRegistry
  - name: AttackRegistry
    details:
      - network: battlechain
        address: "${ATTACK_REGISTRY_ADDRESS}"
        start_block: "${BATTLECHAIN_START_BLOCK}"
    abi: ./abis/AttackRegistry.abi.json
    include_events:
      - AgreementStateChanged
      - ContractRegistered
      - AgreementOwnerAuthorized
      - AttackModeratorTransferred

  # Agreement Factory - tracks new agreement deployments
  - name: AgreementFactory
    details:
      - network: battlechain
        address: "${AGREEMENT_FACTORY_ADDRESS}"
        start_block: "${BATTLECHAIN_START_BLOCK}"
    abi: ./abis/AgreementFactory.abi.json
    include_events:
      - AgreementCreated

  # BattleChain Safe Harbor Registry - tracks adoptions
  - name: BattleChainSafeHarborRegistry
    details:
      - network: battlechain
        address: "${SAFE_HARBOR_REGISTRY_ADDRESS}"
        start_block: "${BATTLECHAIN_START_BLOCK}"
    abi: ./abis/BattleChainSafeHarborRegistry.abi.json
    include_events:
      - BattleChainSafeHarborAdoption

  # Individual Agreement contracts - indexed via factory pattern
  # Note: start_block is set to ensure discovered contracts are indexed from their creation block
  # This works with rindexer's "birth block optimization" to avoid missing events
  - name: Agreement
    details:
      - network: battlechain
        start_block: "${BATTLECHAIN_START_BLOCK}"
        factory:
          name: AgreementFactory
          address: "${AGREEMENT_FACTORY_ADDRESS}"
          abi: ./abis/AgreementFactory.abi.json
          event_name: AgreementCreated
          input_name: "agreementAddress"
    abi: ./abis/Agreement.abi.json
    include_events:
      - ProtocolNameUpdated
      - AgreementURIUpdated
      - BountyTermsUpdated
      - ContactDetailsSet
      - CommitmentWindowExtended
      - BattleChainScopeAddressAdded
      - BattleChainScopeAddressRemoved
      - BattleChainScopeCleared
      - AccountAdded
      - AccountRemoved
      - ChainAddedOrSet
      - ChainRemoved

  # Confidence Pool Factory - tracks new pool deployments and factory config changes
  - name: ConfidencePoolFactory
    details:
      - network: battlechain
        address: "${CONFIDENCE_POOL_FACTORY_ADDRESS}"
        start_block: "${BATTLECHAIN_START_BLOCK}"
    abi: ./abis/ConfidencePoolFactory.abi.json
    include_events:
      - PoolCreated
      - SafeHarborRegistryUpdated
      - PoolImplementationUpdated
      - DefaultOutcomeModeratorUpdated
      - StakeTokenAllowedUpdated
      - OwnershipTransferred
      - OwnershipTransferStarted
      - Paused
      - Unpaused
      - Upgraded

  # Individual Confidence Pool clones - indexed via factory pattern
  - name: ConfidencePool
    details:
      - network: battlechain
        start_block: "${BATTLECHAIN_START_BLOCK}"
        factory:
          name: ConfidencePoolFactory
          address: "${CONFIDENCE_POOL_FACTORY_ADDRESS}"
          abi: ./abis/ConfidencePoolFactory.abi.json
          event_name: PoolCreated
          input_name: "pool"
    abi: ./abis/ConfidencePool.abi.json
    include_events:
      - Staked
      - BonusContributed
      - Withdrawn
      - OutcomeFlagged
      - ClaimSurvived
      - ClaimCorrupted
      - AttackerBountyClaimed
      - UnclaimedCorruptedSwept
      - BonusSwept
      - ClaimExpired
      - RecoveryAddressUpdated
      - ExpiryUpdated
      - ScopeUpdated
      - ScopeLocked
      - RiskWindowStarted
      - RiskWindowEnded
      - Paused
      - Unpaused
      - OwnershipTransferred
      - OwnershipTransferStarted
